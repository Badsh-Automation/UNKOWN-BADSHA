name: UNKOWN BADSHA

on:
  schedule:
    - cron: "*/5 * * * *"   # GitHub ka minimum interval 5 min hai
  workflow_dispatch:

permissions:
  contents: write            # state.json commit karne ke liye

concurrency:
  group: badsha
  cancel-in-progress: false

jobs:
  run:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: "3.11"
          cache: pip
      - run: pip install -r requirements.txt
      - name: Run indicator
        run: python indicator.py
        env:
          EMAIL_USER: ${{ secrets.EMAIL_USER }}
          EMAIL_PASS: ${{ secrets.EMAIL_PASS }}
          EMAIL_TO: ${{ secrets.EMAIL_TO }}
          SYMBOL: GC=F
          INTERVAL: 5m
      - name: Save state
        run: |
          git config user.name "badsha-bot"
          git config user.email "badsha-bot@users.noreply.github.com"
          git add state.json
          git diff --staged --quiet || (git commit -m "update state" && git push)
